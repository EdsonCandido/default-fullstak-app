# Copy to .env: cp .env.example .env
# Single source of truth — all apps read from the monorepo root .env
# If you change ports, also update DATABASE_URL, BETTER_AUTH_URL, CORS_ORIGIN, and VITE_SERVER_URL.

COMPOSE_PROJECT_NAME=default-full-app

# --- Ports (local dev / docker-compose) ---
WEB_PORT=3001
SERVER_PORT=3000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=password

# --- Domains (used by docker-compose.prod.yml + NPM Proxy Hosts) ---
WEB_DOMAIN=app.exemplo.com
API_DOMAIN=api.exemplo.com

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/default-full-app

# --- Auth & API ---
BETTER_AUTH_SECRET=change-me-to-a-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# --- Frontend (build-time for Docker, runtime for Vite dev) ---
VITE_SERVER_URL=http://localhost:3000
