# Copy to .env: cp .env.example .env
# If you change ports, also update DATABASE_URL, BETTER_AUTH_URL, CORS_ORIGIN, and VITE_SERVER_URL.

COMPOSE_PROJECT_NAME=default-full-app

WEB_PORT=3001
SERVER_PORT=3000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=password

DATABASE_URL=postgresql://postgres:password@localhost:5432/default-full-app

BETTER_AUTH_SECRET=change-me-to-a-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

VITE_SERVER_URL=http://localhost:3000
