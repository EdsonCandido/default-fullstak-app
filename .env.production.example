# Copy to .env on the production server: cp .env.production.example .env
# Requires Nginx Proxy Manager on the external "proxy" Docker network.

COMPOSE_PROJECT_NAME=default-full-app

# --- Domains (NPM Proxy Hosts) ---
WEB_DOMAIN=app.exemplo.com
API_DOMAIN=api.exemplo.com

# --- Database (internal — host overridden by docker-compose.prod.yml) ---
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql://postgres:change-me-to-a-strong-password@postgres:5432/default-full-app

# --- Auth & API (HTTPS required in production) ---
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://api.exemplo.com
CORS_ORIGIN=https://app.exemplo.com

# --- Frontend (baked into the web image at build time) ---
VITE_SERVER_URL=https://api.exemplo.com

# --- Runtime ---
NODE_ENV=production
